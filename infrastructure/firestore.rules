rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tide predictions are public reference data: anyone may read; no client
    // may write (the backend service account writes and bypasses these rules).
    match /tide_predictions/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Weather forecasts are public reference data, same as tides: anyone may
    // read; no client may write (the backend service account bypasses rules).
    match /weather_forecasts/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Water-release status, same as tides/weather: anyone may read; no client
    // may write (the backend service account bypasses rules).
    match /water_release_status/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Day ratings, same as the sources they are computed from: anyone may
    // read; no client may write (the decision engine's service account
    // bypasses these rules).
    match /day_ratings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Club members: name, role, and (for a parent) the athlete they are linked
    // to. Any signed-in member may read the roster — the app shows who is going
    // to a session by name and face. Nobody may write from a client; profiles
    // and roles are assigned deliberately, not self-declared.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Invite codes are shared secrets. No client may read them — a code is
    // presented and checked by the membership function, never enumerated from
    // the app — and no client may write them.
    match /invite_codes/{code} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
